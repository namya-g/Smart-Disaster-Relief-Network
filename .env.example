# Copy this file to .env and fill in SECRET_KEY. Never commit .env.
# Generate a key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 = debug mode (local development only), 0 = off
FLASK_DEBUG=1

# Set to 1 only when serving over HTTPS
SESSION_COOKIE_SECURE=0

# Hours before a login session expires
SESSION_HOURS=8

# Optional: custom database file path (default: instance/sdrn.sqlite)
# DATABASE_PATH=
